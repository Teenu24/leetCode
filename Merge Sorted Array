class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        // Early termination - if nums2 is empty, nothing to merge
        if (n == 0) return;
        
        int i = m - 1;      // Last element in nums1's valid portion
        int j = n - 1;      // Last element in nums2
        int k = m + n - 1;  // Last position in nums1
        
        // Merge from back to front
        while (j >= 0) {
            // Use bitwise comparison for potential micro-optimization
            // and eliminate redundant bounds check by restructuring condition
            nums1[k--] = (i >= 0 && nums1[i] > nums2[j]) ? nums1[i--] : nums2[j--];
        }
        
        // No need to handle remaining nums1 elements - they're already in place
    }
}
